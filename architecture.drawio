          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Orchestrator Box -->
        <mxCell id="node-orchestrator" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;🎯 Multi-Agent Swarm Orchestrator&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#cbd5e1&quot; style=&quot;font-size: 11px;&quot;&gt;Coordinates Workflow • Manages State Machine • Executes Parallel Fan-Out&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1d4ed8;strokeColor=#93c5fd;strokeWidth=2;fontColor=#ffffff;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="300" width="400" height="60" as="geometry"/>
        </mxCell>

        <!-- Edge 2 to 3 -->
        <mxCell id="edge-2-3" value="Dispatch Task to Orchestrator" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#818cf8;strokeWidth=2;fontColor=#94a3b8;fontSize=10;" edge="1" parent="1" source="node-gateway" target="node-orchestrator">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- CONTAINER: Parallel Review Agents Swarm -->
        <mxCell id="agents-group" value="3. Specialized Review Agents Swarm (Parallel Fan-Out via asyncio.gather)" style="swimlane;whiteSpace=wrap;html=1;fontStyle=1;align=center;verticalAlign=top;startSize=26;fillColor=#0f172a;strokeColor=#334155;fontColor=#f8fafc;rounded=1;arcSize=6;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="400" width="1040" height="150" as="geometry"/>
        </mxCell>

        <!-- Agent 1: Quality -->
        <mxCell id="agent-quality" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;🧹 Code Quality Sentinel&lt;/b&gt;&lt;hr style=&quot;border-color: #334155;&quot;&gt;&lt;div style=&quot;text-align: left; font-size: 11px; padding: 2px;&quot;&gt;• PEP8 &amp;amp; Type Annotations&lt;br&gt;• Unmanaged File/Socket Leaks&lt;br&gt;• McCabe Cyclomatic Complexity &amp;gt; 10&lt;br&gt;• Docstrings &amp;amp; Code Smells&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#064e3b;strokeColor=#10b981;strokeWidth=2;fontColor=#ecfdf5;shadow=0;" vertex="1" parent="agents-group">
          <mxGeometry x="30" y="38" width="290" height="96" as="geometry"/>
        </mxCell>

        <!-- Agent 2: Security -->
        <mxCell id="agent-security" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;🛡️ Security Sentinel&lt;/b&gt;&lt;hr style=&quot;border-color: #334155;&quot;&gt;&lt;div style=&quot;text-align: left; font-size: 11px; padding: 2px;&quot;&gt;• CWE-89: SQL Injection (f-strings)&lt;br&gt;• CWE-78: OS Command Injection&lt;br&gt;• CWE-798: Hardcoded Secrets/Keys&lt;br&gt;• CVSS 3.1 Severity Scoring&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4c0519;strokeColor=#f43f5e;strokeWidth=2;fontColor=#fff1f2;shadow=0;" vertex="1" parent="agents-group">
          <mxGeometry x="375" y="38" width="290" height="96" as="geometry"/>
        </mxCell>

        <!-- Agent 3: Testing -->
        <mxCell id="agent-test" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;🧪 Test Coverage Sentinel&lt;/b&gt;&lt;hr style=&quot;border-color: #334155;&quot;&gt;&lt;div style=&quot;text-align: left; font-size: 11px; padding: 2px;&quot;&gt;• Boundary Off-By-One (&amp;lt; vs &amp;lt;=)&lt;br&gt;• Missing Negative Input Checks&lt;br&gt;• Assertion Coverage Gaps&lt;br&gt;• Parameterized Test Synthesis&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3b0764;strokeColor=#a855f7;strokeWidth=2;fontColor=#faf5ff;shadow=0;" vertex="1" parent="agents-group">
          <mxGeometry x="720" y="38" width="290" height="96" as="geometry"/>
        </mxCell>

        <!-- Fan out edges from Orchestrator -->
