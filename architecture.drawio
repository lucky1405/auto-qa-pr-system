  <diagram id="auto-qa-pr-sentinel-human-sketch" name="Human Whiteboard Architecture">
    <mxGraphModel dx="1400" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1100" math="0" shadow="1">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title Note / Whiteboard Header -->
        <mxCell id="wb-title" value="&lt;b style=&quot;font-size: 18px;&quot;&gt;📝 Auto-QA PR Sentinel — Architecture Board&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;System Concept: Autonomous Software Quality Swarm + RAG + Docker Sandbox + Telemetry&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;size=16;verticalAlign=top;align=left;spacingTop=6;spacingLeft=10;fillColor=#fff9c4;strokeColor=#d97706;strokeWidth=2;fontFamily=Architects Daughter, Comic Sans MS, cursive;sketch=1;curveFitting=1;jiggle=2;shadow=1;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="60" y="20" width="560" height="70" as="geometry"/>
        </mxCell>

        <!-- Sticky Note: Author / Team -->
        <mxCell id="wb-author-note" value="&lt;b&gt;📌 Design Principle:&lt;/b&gt;&lt;br&gt;&lt;i&gt;&quot;Zero-Trust AI: Never commit code without passing sandboxed pytest!&quot;&lt;/i&gt;" style="shape=note;whiteSpace=wrap;html=1;size=12;verticalAlign=middle;align=center;fillColor=#fef08a;strokeColor=#ca8a04;strokeWidth=1.5;fontFamily=Architects Daughter, Comic Sans MS, cursive;sketch=1;jiggle=2;shadow=1;fontColor=#854d0e;rotation=2;" vertex="1" parent="1">
          <mxGeometry x="840" y="20" width="260" height="70" as="geometry"/>
        </mxCell>

        <!-- STEP 1: Developer PR -->
        <mxCell id="node-pr" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;👨‍💻 1. Developer opens PR&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;(GitHub Pull Request Webhook)&lt;br&gt;Code Diffs &amp;amp; Changed Files&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=2.5;fontFamily=Architects Daughter, Comic Sans MS, cursive;sketch=1;curveFitting=1;jiggle=2.5;shadow=1;fontColor=#0c4a6e;" vertex="1" parent="1">
          <mxGeometry x="420" y="110" width="320" height="65" as="geometry"/>
        </mxCell>

        <!-- STEP 2: FastAPI Gateway & Worker Pool -->
        <mxCell id="node-gateway" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;⚡ 2. FastAPI Gateway &amp;amp; Worker Pool&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Async Queue (Non-blocking) • WebSocket Live Events&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;strokeWidth=2.5;fontFamily=Architects Daughter, Comic Sans MS, cursive;sketch=1;curveFitting=1;jiggle=2;shadow=1;fontColor=#4c1d95;" vertex="1" parent="1">
          <mxGeometry x="410" y="210" width="340" height="65" as="geometry"/>
        </mxCell>

        <!-- Arrow PR -> Gateway -->
        <mxCell id="arrow-1" value="webhook payload" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=2.5;fontFamily=Architects Daughter, Comic Sans MS, cursive;sketch=1;jiggle=2;fontColor=#0369a1;fontSize=11;" edge="1" parent="1" source="node-pr" target="node-gateway">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- STEP 3: Swarm Orchestrator (Manager) -->
        <mxCell id="node-orchestrator" value="&lt;b style=&quot;font-size: 15px;&quot;&gt;🎯 3. Swarm Orchestrator (The Manager)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;State Machine • Dispatches Review Jobs in Parallel • Collects Feedback&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=3;fontFamily=Architects Daughter, Comic Sans MS, cursive;sketch=1;curveFitting=1;jiggle=2.5;shadow=1;fontColor=#1e3a8a;" vertex="1" parent="1">
          <mxGeometry x="380" y="310" width="400" height="70" as="geometry"/>
        </mxCell>

        <!-- Arrow Gateway -> Orchestrator -->
        <mxCell id="arrow-2" value="dispatch task" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=2.5;fontFamily=Architects Daughter, Comic Sans MS, cursive;sketch=1;jiggle=2;fontColor=#6d28d9;fontSize=11;" edge="1" parent="1" source="node-gateway" target="node-orchestrator">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Hand-drawn sticky: Parallel Fan-out note -->
        <mxCell id="note-fanout" value="⚡ &lt;b&gt;Parallel Fan-Out&lt;/b&gt;&lt;br&gt;All 3 review agents run at the same time!" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#fef08a;strokeColor=#ca8a04;strokeWidth=1.5;fontFamily=Architects Daughter, Comic Sans MS, cursive;sketch=1;jiggle=2;fontColor=#713f12;fontSize=10;rotation=-4;" vertex="1" parent="1">
          <mxGeometry x="110" y="325" width="200" height="55" as="geometry"/>
        </mxCell>

        <!-- STEP 4A: Code Quality Agent (Green Sticky) -->
        <mxCell id="node-agent-qual" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;🧹 Code Quality Sentinel&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;• PEP8 &amp;amp; Type Hints&lt;br&gt;• Unclosed File / Socket Leaks&lt;br&gt;• Cyclomatic Complexity &amp;gt; 10&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2.5;fontFamily=Architects Daughter, Comic Sans MS, cursive;sketch=1;curveFitting=1;jiggle=2.5;shadow=1;fontColor=#14532d;rotation=-1;" vertex="1" parent="1">
          <mxGeometry x="70" y="420" width="290" height="90" as="geometry"/>
        </mxCell>

        <!-- STEP 4B: Security Agent (Pink Sticky) -->
        <mxCell id="node-agent-sec" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;🛡️ Security Sentinel&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;• CWE-89: SQL Injection (f-string)&lt;br&gt;• CWE-78: Command Injection&lt;br&gt;• CWE-798: Hardcoded Secrets&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe4e6;strokeColor=#e11d48;strokeWidth=2.5;fontFamily=Architects Daughter, Comic Sans MS, cursive;sketch=1;curveFitting=1;jiggle=2.5;shadow=1;fontColor=#881337;" vertex="1" parent="1">
          <mxGeometry x="435" y="420" width="290" height="90" as="geometry"/>
        </mxCell>

        <!-- STEP 4C: Test Agent (Purple Sticky) -->
        <mxCell id="node-agent-test" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;🧪 Test Coverage Sentinel&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;• Boundary Off-By-One (&amp;lt; vs &amp;lt;=)&lt;br&gt;• Negative Input Rejection&lt;br&gt;• Parameterized Unit Tests&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9333ea;strokeWidth=2.5;fontFamily=Architects Daughter, Comic Sans MS, cursive;sketch=1;curveFitting=1;jiggle=2.5;shadow=1;fontColor=#581c87;rotation=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="420" width="290" height="90" as="geometry"/>
        </mxCell>

        <!-- Fan out arrows from Orchestrator -->
        <mxCell id="fan-1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16a34a;strokeWidth=2.5;fontFamily=Architects Daughter, Comic Sans MS, cursive;sketch=1;jiggle=2;" edge="1" parent="1" source="node-orchestrator" target="node-agent-qual">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="fan-2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#e11d48;strokeWidth=2.5;fontFamily=Architects Daughter, Comic Sans MS, cursive;sketch=1;jiggle=2;" edge="1" parent="1" source="node-orchestrator" target="node-agent-sec">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="fan-3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9333ea;strokeWidth=2.5;fontFamily=Architects Daughter, Comic Sans MS, cursive;sketch=1;jiggle=2;" edge="1" parent="1" source="node-orchestrator" target="node-agent-test">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- STEP 5: Hybrid RAG & Knowledge Base -->
        <mxCell id="node-rag" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;🧠 4. Hybrid RAG Engine&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;BM25 Lexical + Cosine Vector Search&lt;br&gt;Grounds the AI with company rules &amp;amp; fix patterns&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=2.5;fontFamily=Architects Daughter, Comic Sans MS, cursive;sketch=1;curveFitting=1;jiggle=2;shadow=1;fontColor=#78350f;" vertex="1" parent="1">
          <mxGeometry x="260" y="555" width="340" height="75" as="geometry"/>
        </mxCell>

        <!-- Cylinder: Knowledge Base -->
        <mxCell id="node-kb" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;📚 Project Knowledge Base&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;• SQL Injection Prevention (KB-SEC-001)&lt;br&gt;• Context Managers (KB-REL-002)&lt;br&gt;• Boundary Tier Rules (KB-LOGIC-003)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=2;fontFamily=Architects Daughter, Comic Sans MS, cursive;sketch=1;curveFitting=1;jiggle=2;shadow=1;fontColor=#78350f;" vertex="1" parent="1">
          <mxGeometry x="670" y="545" width="280" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="arrow-kb-rag" value="look up rules" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b45309;strokeWidth=2;dashed=1;fontFamily=Architects Daughter, Comic Sans MS, cursive;sketch=1;jiggle=2;fontColor=#92400e;fontSize=10;" edge="1" parent="1" source="node-kb" target="node-rag">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Arrow from Agents to RAG -->
        <mxCell id="arrow-agents-rag" value="Issues found! Query guidelines" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d97706;strokeWidth=2.5;fontFamily=Architects Daughter, Comic Sans MS, cursive;sketch=1;jiggle=2;fontColor=#92400e;fontSize=11;fontStyle=1;" edge="1" parent="1" source="node-agent-sec" target="node-rag">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- STEP 6: Fix Agent (The Mechanic) -->
        <mxCell id="node-fix-agent" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;🔧 5. Fix Agent (Automated Software Repair)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Synthesizes Unified Diff Patch based on AST + RAG Rules + Error Feedback&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cffafe;strokeColor=#0891b2;strokeWidth=2.5;fontFamily=Architects Daughter, Comic Sans MS, cursive;sketch=1;curveFitting=1;jiggle=2.5;shadow=1;fontColor=#164e63;" vertex="1" parent="1">
          <mxGeometry x="370" y="670" width="420" height="65" as="geometry"/>
        </mxCell>

        <!-- Arrow RAG -> Fix Agent -->
        <mxCell id="arrow-rag-fix" value="guidelines &amp;amp; fix pattern" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0891b2;strokeWidth=2.5;fontFamily=Architects Daughter, Comic Sans MS, cursive;sketch=1;jiggle=2;fontColor=#0e7490;fontSize=10;" edge="1" parent="1" source="node-rag" target="node-fix-agent">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- STEP 7: Sandbox (Test Chamber) -->
        <mxCell id="node-sandbox" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;🐳 6. Zero-Trust Sandbox (Isolated Test Chamber)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;• Isolated Tempjail / Docker Container (Resource Limits &amp;amp; 15s Timeout)&lt;br&gt;• Executes Pytest Unit Test Suite • AST-level Security Check&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=3;fontFamily=Architects Daughter, Comic Sans MS, cursive;sketch=1;curveFitting=1;jiggle=2.5;shadow=1;fontColor=#7f1d1d;" vertex="1" parent="1">
          <mxGeometry x="350" y="775" width="460" height="80" as="geometry"/>
        </mxCell>

        <!-- Arrow Fix Agent -> Sandbox -->
        <mxCell id="arrow-fix-sand" value="candidate patch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0891b2;strokeWidth=2.5;fontFamily=Architects Daughter, Comic Sans MS, cursive;sketch=1;jiggle=2;fontColor=#0e7490;fontSize=11;fontStyle=1;" edge="1" parent="1" source="node-fix-agent" target="node-sandbox">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- RETRY LOOP (Loop back up to Fix Agent) -->
        <mxCell id="node-retry-note" value="&lt;b style=&quot;color: #b91c1c;&quot;&gt;↺ Retry Loop (Max 3 attempts)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Sends traceback &amp;amp; failure logs&lt;br&gt;back to Fix Agent!&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;dashed=1;fontFamily=Architects Daughter, Comic Sans MS, cursive;sketch=1;jiggle=2;fontColor=#991b1b;rotation=-3;" vertex="1" parent="1">
          <mxGeometry x="110" y="705" width="200" height="65" as="geometry"/>
        </mxCell>

        <mxCell id="arrow-fail-retry" value="Tests Fail ❌" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#ef4444;strokeWidth=2.5;fontFamily=Architects Daughter, Comic Sans MS, cursive;sketch=1;jiggle=2;fontColor=#b91c1c;fontSize=10;fontStyle=1;" edge="1" parent="1" source="node-sandbox" target="node-retry-note">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="210" y="815"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="arrow-retry-fix" value="feedback trace" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#ef4444;strokeWidth=2.5;fontFamily=Architects Daughter, Comic Sans MS, cursive;sketch=1;jiggle=2;fontColor=#b91c1c;fontSize=10;" edge="1" parent="1" source="node-retry-note" target="node-fix-agent">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="210" y="702"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- STEP 8: Verified Commit & PR Approval (Green Box) -->
        <mxCell id="node-commit" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;✅ 7. Verified Commit on PR&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Generated Commit Hash (e.g. 9f4a1c7e)&lt;br&gt;Auto-PR Approved &amp;amp; Review Comment Posted!&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d1fae5;strokeColor=#059669;strokeWidth=3;fontFamily=Architects Daughter, Comic Sans MS, cursive;sketch=1;curveFitting=1;jiggle=2.5;shadow=1;fontColor=#064e3b;" vertex="1" parent="1">
          <mxGeometry x="170" y="900" width="370" height="75" as="geometry"/>
        </mxCell>

        <mxCell id="arrow-sand-pass" value="Tests Passed 100% ✅" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=3;fontFamily=Architects Daughter, Comic Sans MS, cursive;sketch=1;jiggle=2;fontColor=#047857;fontSize=11;fontStyle=1;" edge="1" parent="1" source="node-sandbox" target="node-commit">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="430" y="875"/>
              <mxPoint x="355" y="875"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- STEP 9: Telemetry & Report Card (Teal Sticky) -->
        <mxCell id="node-metrics" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;📊 8. Quality &amp;amp; Reliability Report Card&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;• &lt;b&gt;SRI (Reliability Index)&lt;/b&gt;: 98.5 / 100&lt;br&gt;• &lt;b&gt;Projected MTBF&lt;/b&gt;: 25,000+ hrs&lt;br&gt;• &lt;b&gt;Defect Detection Rate&lt;/b&gt;: 100% | &lt;b&gt;FPR&lt;/b&gt;: 0.0%&lt;br&gt;• &lt;b&gt;Maintainability Index (MI)&lt;/b&gt;: 89.2 (SEI)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#0d9488;strokeWidth=2.5;fontFamily=Architects Daughter, Comic Sans MS, cursive;sketch=1;curveFitting=1;jiggle=2.5;shadow=1;fontColor=#134e4a;" vertex="1" parent="1">
          <mxGeometry x="610" y="890" width="380" height="95" as="geometry"/>
