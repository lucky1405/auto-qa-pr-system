          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Sandbox Runner -->
        <mxCell id="node-sandbox" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;🐳 Zero-Trust Verification Sandbox&lt;/b&gt;&lt;hr style=&quot;border-color: #334155;&quot;&gt;&lt;div style=&quot;text-align: left; font-size: 11px; padding: 2px;&quot;&gt;• &lt;b&gt;Isolated Tempjail / Docker Container&lt;/b&gt; (Resource Limits &amp;amp; Timeouts)&lt;br&gt;• Executes &lt;b&gt;Pytest Unit Suites&lt;/b&gt; (Passing / Failing assertions)&lt;br&gt;• AST-level &lt;b&gt;Security &amp;amp; Linter Checks&lt;/b&gt; (No raw string injections)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#f43f5e;strokeWidth=2;fontColor=#f8fafc;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="815" width="440" height="85" as="geometry"/>
        </mxCell>

        <!-- Edge Fix Agent to Sandbox -->
        <mxCell id="edge-fix-sand" value="Candidate Patch Proposal" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=2;fontColor=#bae6fd;fontSize=10;fontStyle=1;" edge="1" parent="1" source="node-fix-agent" target="node-sandbox">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Retry Loop Box (Left side of Sandbox and Fix Agent) -->
        <mxCell id="node-retry" value="&lt;b style=&quot;color: #f43f5e;&quot;&gt;Iterative Retry Loop&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#cbd5e1&quot; style=&quot;font-size: 10px;&quot;&gt;Feedback: stderr, traceback&lt;br&gt;Max Attempts: 3&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#450a0a;strokeColor=#f43f5e;strokeWidth=2;dashed=1;fontColor=#fecdd3;" vertex="1" parent="1">
          <mxGeometry x="120" y="750" width="180" height="60" as="geometry"/>
        </mxCell>

        <!-- Edge Sandbox to Retry -->
