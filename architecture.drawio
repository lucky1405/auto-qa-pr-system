        <!-- Bottom Doodle Note -->
        <mxCell id="wb-footer-note" value="💡 &lt;b&gt;Key Viva Point:&lt;/b&gt; Notice how Fix Agent never bypasses Sandbox. Even if LLM hallucinates, Sandbox catches it and triggers the Retry Loop!" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#fffbeb;strokeColor=#f59e0b;strokeWidth=1.5;fontFamily=Architects Daughter, Comic Sans MS, cursive;sketch=1;jiggle=2;fontColor=#92400e;fontSize=10;" vertex="1" parent="1">
