          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge-orch-sec" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#f43f5e;strokeWidth=2;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="node-orchestrator" target="agent-security">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge-orch-test" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#a855f7;strokeWidth=2;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="node-orchestrator" target="agent-test">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- RAG Engine and Knowledge Base -->
        <mxCell id="node-rag" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;🧠 Hybrid RAG Engine&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#cbd5e1&quot; style=&quot;font-size: 11px;&quot;&gt;• BM25 Lexical Keyword Search&lt;br&gt;• Cosine Vector Similarity Ranking&lt;br&gt;• Grounding Metrics: Relevance &amp;amp; Faithfulness&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#713f12;strokeColor=#eab308;strokeWidth=2;fontColor=#fefce8;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="240" y="590" width="330" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="node-kb" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;📚 Project Knowledge Base&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#cbd5e1&quot; style=&quot;font-size: 11px;&quot;&gt;• SQL Injection Prevention Rules&lt;br&gt;• Context Manager Guidelines&lt;br&gt;• Historical Bug Fix Patterns (APR)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#1e293b;strokeColor=#f59e0b;strokeWidth=2;fontColor=#fef08a;" vertex="1" parent="1">
          <mxGeometry x="640" y="580" width="280" height="95" as="geometry"/>
        </mxCell>

        <!-- Connect KB to RAG -->
