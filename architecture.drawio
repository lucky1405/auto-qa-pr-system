        <mxCell id="arrow-sand-metrics" value="calculate metrics" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0d9488;strokeWidth=2.5;fontFamily=Architects Daughter, Comic Sans MS, cursive;sketch=1;jiggle=2;fontColor=#0f766e;fontSize=10;" edge="1" parent="1" source="node-sandbox" target="node-metrics">
