        <!-- OUTPUT: Metrics Engine -->
        <mxCell id="node-metrics" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;📊 Quality &amp;amp; Reliability Telemetry&lt;/b&gt;&lt;hr style=&quot;border-color: #334155;&quot;&gt;&lt;div style=&quot;text-align: left; font-size: 10px; padding: 2px;&quot;&gt;• &lt;b&gt;SRI (Software Reliability Index)&lt;/b&gt;: 98.5 / 100&lt;br&gt;• &lt;b&gt;Projected MTBF&lt;/b&gt;: 25,000+ hours (1/&amp;lambda;)&lt;br&gt;• &lt;b&gt;Defect Detection Rate&lt;/b&gt;: 100% | &lt;b&gt;FPR&lt;/b&gt;: 0.0%&lt;br&gt;• &lt;b&gt;Maintainability Index (MI)&lt;/b&gt;: 89.2 (SEI)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#134e4a;strokeColor=#14b8a6;strokeWidth=2;fontColor=#f0fdfa;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="930" width="370" height="90" as="geometry"/>
