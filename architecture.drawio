          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Fix Agent -->
        <mxCell id="node-fix-agent" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;🔧 Automated Fix Agent (APR)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#cbd5e1&quot; style=&quot;font-size: 11px;&quot;&gt;Synthesizes Unified Diff Patch based on Diagnostics, RAG Guidelines &amp;amp; Feedback&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0c4a6e;strokeColor=#0284c7;strokeWidth=2;fontColor=#f0f9ff;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="710" width="400" height="65" as="geometry"/>
        </mxCell>

