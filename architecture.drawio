<mxfile host="app.diagrams.net" modified="2026-10-21T11:00:00.000Z" agent="Mozilla/5.0" version="24.0.0" type="device">
  <diagram id="auto-qa-pr-sentinel-arch" name="Auto-QA PR Sentinel Architecture">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1050" math="0" shadow="1">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- CONTAINER: External Trigger Layer -->
        <mxCell id="trigger-group" value="1. Pull Request Ingestion Layer" style="swimlane;whiteSpace=wrap;html=1;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#1e293b;strokeColor=#475569;fontColor=#f8fafc;rounded=1;arcSize=8;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="30" width="400" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="node-dev-pr" value="&lt;b&gt;Developer Creates GitHub PR&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#94a3b8&quot; style=&quot;font-size: 11px;&quot;&gt;Webhook Trigger / PR Diff &amp;amp; Changed Files&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#3b82f6;strokeWidth=2;fontColor=#f8fafc;shadow=0;" vertex="1" parent="trigger-group">
          <mxGeometry y="26" width="400" height="64" as="geometry"/>
        </mxCell>

        <!-- CONTAINER: Gateway & Concurrency Queue -->
        <mxCell id="gateway-group" value="2. Gateway &amp; Scalable Async Task Queue" style="swimlane;whiteSpace=wrap;html=1;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#1e293b;strokeColor=#475569;fontColor=#f8fafc;rounded=1;arcSize=8;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="160" width="440" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="node-gateway" value="&lt;b&gt;FastAPI Gateway &amp;amp; Scalable Worker Pool&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#94a3b8&quot; style=&quot;font-size: 11px;&quot;&gt;• Async Task Queue (Non-blocking Ingestion)&lt;br&gt;• Pub/Sub Real-time WebSocket Event Stream&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e1b4b;strokeColor=#6366f1;strokeWidth=2;fontColor=#f8fafc;shadow=0;" vertex="1" parent="gateway-group">
          <mxGeometry y="26" width="440" height="74" as="geometry"/>
        </mxCell>

        <!-- Edge 1 to 2 -->
